<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral checks of the ported engine logic (JSON shapes, settings and history round-trips, prompts).
       Runs anywhere: dotnet run -project tests/EngineTests -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../ProsperPalette/Engine/Core.cs" Link="Engine/Core.cs" />
    <Compile Include="../../ProsperPalette/Engine/Ai.cs" Link="Engine/Ai.cs" />
    <Compile Include="../../ProsperPalette/Engine/History.cs" Link="Engine/History.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.8" />
  </ItemGroup>
</Project>
